POSTGRES_DB=localrag
POSTGRES_USER=localrag
POSTGRES_PASSWORD=localrag123

POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
KB_API_PORT=8787
OPEN_WEBUI_PORT=3000

OLLAMA_BASE_URL=http://host.docker.internal:11434

CHAT_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b

QDRANT_COLLECTION=local_rag_chunks

# Опциональный локальный reranker-сервис (см. docs/RERANKER_SERVICE.md).
# Если контейнер не поднят, kb-api сам делает fallback на эвристику.
RERANKER_PORT=8090
RERANKER_LOCAL_URL=http://localrag-reranker:8090
# Модель cross-encoder. Альтернатива на CPU слабого ноута:
#   RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B  (тяжелее bge, ~25–40 с на запрос)
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512
# Таймаут HTTP-запроса kb-api к reranker-сервису (мс). Дефолт 45000 рассчитан
# на bge/Qwen3 на CPU слабого ноута (15–30 с). На GPU можно снизить до 5000.
RERANKER_TIMEOUT_MS=45000
